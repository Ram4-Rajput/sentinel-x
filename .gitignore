__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Phase-2 generated caches (large, reproducible via scripts/build_dataset.py).
# Keep the folder + metadata, ignore the bulky window/graph artifacts.
data/processed/*/windows/
data/processed/*/graphs/
data/unified/*
!data/unified/.gitkeep
!data/raw/.gitkeep

# Phase-3 MLflow store + artifacts (regeneratable via scripts/run_baselines.py).
# The result files (baseline_results.csv / baseline_metrics.json / baseline_report.md)
# ARE kept in git; the DB and run artifacts are not.
experiments/mlflow.db
experiments/mlruns/
experiments/mlartifacts/
experiments/art/

# Phase-4+ trained checkpoints + backups (regeneratable via scripts/train.py).
# Keep small metadata/config in git if desired; ignore the bulky weights + backups.
models/**/*.pt
models/**/*.bak_*
models/kaggle_ctu13full/
*.bak_tier*

# Phase-9 reproducibility run manifests / config snapshots (per-run, regeneratable).
experiments/runs/
experiments/phase9/
# Experiment backup files (generated by integrate_kaggle_run.py).
experiments/*.bak_*

# Kaggle bundles (regeneratable via scripts/pack_kaggle.py).
dist/kaggle/
# Kaggle training download zips (large, stored outside git).
*.zip
*.tar
*.tar.gz
*.tar.bz2

# Local environments, secrets, logs, and editor state.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.secret
*.log
.vscode/
.idea/
.kiro/

# Raw and unified data are kept outside GitHub; retain directory markers.
data/raw/*
!data/raw/.gitkeep
data/unified/*
!data/unified/.gitkeep
train.zip
*_kaggle_*.zip

# Build / training logs.
*.log

# Kiro workspace internals (skills dir is huge; not source).
.kiro/

# Editor / OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
